<script type="text/javascript">
    const menuItemMoveUp = (e) => {
        fetch(e.target.dataset.url, {
            method: 'PUT',
        }).then(() => {
            window.location.reload();
        })
    };

    $('.sylius-menu_item-move-up, .sylius-menu_item-move-down').on('click', menuItemMoveUp);
</script>
