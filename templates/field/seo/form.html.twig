{% block happy_cms_seo_widget %}

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link active" href="#">Métas</a>
        </li>
    </ul>

    <div class="row">
        <div class="col field">
            {{ form_row(form.title) }}
        </div>
        <div class="col field">
            {{ form_row(form.keywords) }}
        </div>
    </div>

    <div class="field">
        {{ form_row(form.description) }}
    </div>

    <div class="row">
        <div class="col field">
            {{ form_row(form.cover) }}
        </div>
        <div class="col field">
            {{ form_row(form.canonical) }}
        </div>
    </div>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link active" href="#">Robots & Sitemap</a>
        </li>
    </ul>

    <div class="row">
        <div class="field">
            {{ form_row(form.sitemap) }}
        </div>

        <div class="field">
            {{ form_row(form.robots) }}
        </div>
    </div>

    {{ form_rest(form) }}

{% endblock %}

{% block happy_cms_seo_row %}
<div class="field">
    {{- form_widget(form) -}}
</div>
{% endblock %}
