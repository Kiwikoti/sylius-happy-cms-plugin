{% block happy_cms_seo_widget %}

    <h4 class="ui dividing header">Métas</h4>

    <div class="two fields">
        <div class="field">
            {{ form_row(form.title) }}
        </div>
        <div class="field">
            {{ form_row(form.keywords) }}
        </div>
    </div>

    <div class="field">
        {{ form_row(form.description) }}
    </div>

    <div class="twelve wide field">
        {{ form_row(form.cover) }}
    </div>

    <div class="fields">
        <div class="twelve wide field">
            {{ form_row(form.canonical) }}
        </div>
    </div>

    <h4 class="ui dividing header">Robots & Sitemap</h4>

    <div class="fields">
        <div class="twelve wide field">
            {{ form_row(form.sitemap) }}
        </div>
        <div class="twelve wide field">
            {{ form_row(form.robots) }}
        </div>
    </div>
    {{ form_rest(form) }}

{% endblock %}

{% block happy_cms_seo_row %}
<div class="field">
    {{- form_widget(form) -}}
</div>
{% endblock %}
