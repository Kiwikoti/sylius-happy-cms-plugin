{# @var ea \Adeliom\SyliusEasyCrudPlugin\CrudFactory\Context\AdminContext #}
{# @var field \Adeliom\SyliusEasyCrudPlugin\CrudFactory\Dto\FieldDto #}
{# @var entity \Adeliom\SyliusEasyCrudPlugin\CrudFactory\Dto\EntityDto #}

{% if data is defined and data is not null %}
    {% set html_id = 'happy-cms-media-field-' ~ data.id %}
    {% set infos = data|media_infos %}
    {% if infos %}
        {% if file_is_type(data, 'image') %}
                    <img src="{{ happy_cms_media_path(data) }}" alt="" class="ui image sylius-grid-image" />
                {% elseif file_is_type(data, 'oembed') and data|media_meta('icon') %}
                    <img src="{{ data|media_meta('icon') }}" alt="" class="ui image sylius-grid-image" />
                {% else %}

                {% endif %}
    {% endif %}
{% endif %}
