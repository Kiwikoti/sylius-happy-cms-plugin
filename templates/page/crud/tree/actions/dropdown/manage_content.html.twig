{% set definition = hookable_metadata.context.pages.definition %}
{% if definition.actionGroups.subitem is defined and definition.getEnabledActions('subitem')|length > 0 %}
    {% for action in definition.getEnabledActions('item')|sylius_sort_by('position') %}
        {% if action.name != 'show' and action.name != 'update' and action.name != 'delete' %}
            {% set action_path = action.link.url|default(path(action.link.route|default(grid.requestConfiguration.getRouteName(action.name)), action.link.parameters|default({'id': '__PAGE_ID__'}))) %}
            <li>
                <a class="dropdown-item" href="{{ action_path }}">
                    {{ ux_icon('tabler:' ~ action.icon, { class: 'icon dropdown-item-icon icon-tabler icon-tabler-settings' }) }}
                    {{ action.label|trans }}
                </a>
            </li>
        {% endif %}
    {% endfor %}
    <li class="dropdown-divider"></li>
    {% for action in definition.getEnabledActions('subitem')|sylius_sort_by('position') %}
        {% if action.options.links is defined and action.options.links|length %}
            <li>
                <span class="dropdown-item">
                    {{ ux_icon('tabler:pencil', { class: 'icon dropdown-item-icon icon-tabler icon-tabler-settings' }) }}
                    {{ action.label|trans }}
                </span>
            </li>
            {% for sub_action in action.options.links %}
                {% set action_path = path(sub_action.route|default(''), {...sub_action.parameters, ...{'id': '__PAGE_ID__'}}) %}
                <li>
                    <a class="dropdown-item" href="{{ action_path }}">
                        {{ ux_icon('tabler:globe', { class: 'icon dropdown-item-icon icon-tabler icon-tabler-settings' }) }}
                        {{ sub_action.label|trans }}
                    </a>
                </li>
            {% endfor %}
        {% else %}
            {% set action_path = action.link.url|default(path(action.link.route|default(grid.requestConfiguration.getRouteName(action.name)), action.link.parameters|default({'id': '__PAGE_ID__'}))) %}
            <li>
                <a class="dropdown-item" href="{{ action_path }}">
                <i class="{{ action.icon }} icon grey"></i>{{ action.label|trans }}
                </a>
            </li>
        {% endif %}
    {% endfor %}
{% endif %}
