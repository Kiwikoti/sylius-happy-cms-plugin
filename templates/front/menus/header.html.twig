{% macro item(el) %}
    {% import _self as macros %}

    {% if el.children|length > 0 %}
        <div class="ui dropdown item" {{ sylius_test_html_attribute('menu-item') }}>
            <span class="text">{{ el.name }}</span>
            <i class="dropdown icon"></i>
            <div class="menu">
                {% for child in el.children %}
                    {{ macros.item(child) }}
                {% endfor %}
            </div>
        </div>
    {% else %}
        <a href="#" class="item" {{ sylius_test_html_attribute('menu-item') }}>{{ el.name }}</a>
    {% endif %}
{% endmacro %}

{% import _self as macros %}

{% if menu.items|length > 0 %}
    <div class="ui large stackable menu" {{ sylius_test_html_attribute('menu') }}>
        {% for item in menu.items %}
            {% if item.parent is not null and item.parent.parent is null %}
                {{ macros.item(item) }}
            {% endif %}
        {% endfor %}
    </div>
{% endif %}
