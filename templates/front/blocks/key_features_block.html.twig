{% set headline = settings.headline|default(false) %}
{% set title = settings.title|default(false) %}
{% set wysiwyg = settings.wysiwyg|default(false) %}
{% set features = settings.features|default([]) %}
<section class="container">
    <div class="my-10 lg:my-20 wrapper-12">
        <div class="col-span-full md:col-span-8 md:col-start-3 text-center">
            {% if headline %}<p class="headline">{{ headline }}</p>{% endif %}
            {% if title %}<h2 class="heading-5">{{ title }}</h2>{% endif %}
            {% if wysiwyg %}
                <div class="wysiwyg">
                    {{ wysiwyg|raw }}
                </div>
            {% endif %}
        </div>
        {% if features is not empty %}
            <div class="col-span-full grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
                {% for feature in features %}
                    {% set icon = feature.icon|default('fa-box') %}
                    {% set key = feature.key|default(false) %}
                    {% set text = feature.text|default(false) %}
                    <div class="col-span-1 p-4 md:p-6 bg-neutral-100 text-center">
                        <i class="fa-regular fa-sharp {{ icon }} text-4xl text-primary"></i>
                        <p class="heading-3 mt-4 mb-2">{{ key }}</p>
                        <p>{{ text }}</p>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
